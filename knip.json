{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/mcp/mcp-server.ts",
    "src/statusline/writer.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "ignore": [
    "src/test-utils/**/*",
    "src/harness/index.ts",
    "src/permissions/index.ts"
  ],
  "ignoreDependencies": ["prettier", "hono", "@hono/node-server", "express-rate-limit"],
  "ignoreBinaries": ["pkill", "sleep", "prettier", "knip", "dist/index.js", "codex", "opencode", "pi", "gh", "caffeinate", "systemd-inhibit", "powershell"],
  "ignoreExportsUsedInFile": true
}
