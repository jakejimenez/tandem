{
  "name": "tandem",
  "version": "1.17.0",
  "description": "Screen-sharing for AI pair programming, but everyone can type. Supports Claude Code, OpenCode, Pi, and Codex.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "tandem": "./dist/index.js",
    "tandem-mcp": "./dist/mcp/mcp-server.js",
    "tandem-daemon": "./bin/tandem-daemon"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node && bun build src/mcp/mcp-server.ts --outdir dist/mcp --target node && bun build src/statusline/writer.ts --outdir dist/statusline --target node",
    "compile": "bun build --compile --minify src/index.ts --outfile dist/tandem",
    "compile:linux-x64": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile dist/tandem-linux-x64",
    "compile:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 src/index.ts --outfile dist/tandem-linux-arm64",
    "compile:darwin-x64": "bun build --compile --minify --target=bun-darwin-x64 src/index.ts --outfile dist/tandem-darwin-x64",
    "compile:darwin-arm64": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile dist/tandem-darwin-arm64",
    "compile:windows-x64": "bun build --compile --minify --target=bun-windows-x64 src/index.ts --outfile dist/tandem-windows-x64.exe",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64 && bun run compile:windows-x64",
    "start": "bun dist/index.js",
    "test": "bun test src/",
    "test:watch": "bun test src/ --watch",
    "test:coverage": "bun test src/ --coverage",
    "test:integration:setup": "docker compose -f tests/integration/docker/docker-compose.yml up -d && bun run tests/integration/setup/wait-for-mattermost.ts && bun run tests/integration/setup/setup-mattermost.ts",
    "test:integration:run": "INTEGRATION_TEST=1 bun test tests/integration/suites --timeout 120000",
    "test:integration": "bun run test:integration:setup && bun run test:integration:run",
    "test:integration:teardown": "docker compose -f tests/integration/docker/docker-compose.yml down -v",
    "test:integration:clean": "bun run tests/integration/setup/teardown.ts",
    "test:integration:slack:setup": "bun run tests/integration/fixtures/slack/mock-server.ts &",
    "test:integration:slack:run": "TEST_PLATFORMS=slack INTEGRATION_TEST=1 bun test tests/integration/suites --timeout 120000",
    "test:integration:slack:teardown": "pkill -f 'mock-server.ts' || true",
    "test:integration:slack": "bun run test:integration:slack:teardown; bun run tests/integration/fixtures/slack/mock-server.ts & sleep 2 && TEST_PLATFORMS=slack INTEGRATION_TEST=1 bun test tests/integration/suites --timeout 120000; bun run test:integration:slack:teardown",
    "test:integration:all": "bun run test:integration:setup && bun run tests/integration/fixtures/slack/mock-server.ts & sleep 2 && TEST_PLATFORMS=mattermost,slack INTEGRATION_TEST=1 bun test tests/integration/suites --timeout 120000; bun run test:integration:slack:teardown",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "knip": "npx knip",
    "prepare": "husky"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mattermost",
    "bot",
    "ai",
    "cli",
    "anthropic",
    "chat",
    "bun"
  ],
  "author": "Anne Schuth",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakejimenez/tandem.git"
  },
  "bugs": {
    "url": "https://github.com/jakejimenez/tandem/issues"
  },
  "homepage": "https://github.com/jakejimenez/tandem#readme",
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@hono/node-server": "2.0.6",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@redactpii/node": "^1.0.16",
    "cli-spinners": "^3.3.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "express-rate-limit": "^8.3.0",
    "hono": "4.12.27",
    "ink": "^7.1.0",
    "ink-scroll-view": "^0.3.5",
    "js-yaml": "^5.1.0",
    "prompts": "^2.4.2",
    "react": "^19.2.3",
    "semver": "7.8.5",
    "update-notifier": "^7.3.1",
    "ws": "8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.7",
    "@types/semver": "^7.7.1",
    "@types/update-notifier": "^6.0.8",
    "@types/ws": "^8.18.0",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.2.21"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.test.ts": "bun test --bail",
    "*.{ts,tsx}": "bash -c 'tsc --noEmit'",
    "website/**/*.{html,css,js}": "prettier --write"
  },
  "overrides": {
    "hono": "$hono",
    "@hono/node-server": "$@hono/node-server",
    "express-rate-limit": "$express-rate-limit",
    "flatted": ">=3.4.0",
    "picomatch": ">=2.3.2",
    "path-to-regexp": ">=8.4.0",
    "fast-uri": ">=3.1.2"
  },
  "resolutions": {
    "hono": "$hono",
    "@hono/node-server": "$@hono/node-server",
    "express-rate-limit": "$express-rate-limit",
    "flatted": ">=3.4.0",
    "picomatch": ">=2.3.2",
    "path-to-regexp": ">=8.4.0",
    "fast-uri": ">=3.1.2"
  }
}
